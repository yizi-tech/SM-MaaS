# =============================================================================
# MASS 部署环境变量模板
# 复制为 .env 并填入真实值。服务在缺少以下必填项时会拒绝启动：
#   JWT_SECRET / DB_PASSWORD / REDIS_PASSWORD
# 生成随机密钥示例（Linux/macOS）：
#   openssl rand -hex 32
# =============================================================================

# REQUIRED - 至少 32 字节随机字符串，用于签发/校验 JWT（泄露=可伪造管理员）
JWT_SECRET=

# REQUIRED - MySQL 密码（MySQL 容器与 api 服务共用）
DB_PASSWORD=

# REQUIRED - Redis 密码（Redis 容器与 api 服务共用）
REDIS_PASSWORD=

# 可选 - 数据库名 / 用户名（默认 mass）
DB_NAME=mass
DB_USER=mass

# OpenAI 兼容渠道（可选，未配置时仅使用管理后台配置的 DB 渠道）
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=

# Anthropic 渠道（可选）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# Stripe 支付配置（可选，预留）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP 配置（可选，用于余额预警 / 发票等邮件通知）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mass-platform.com
