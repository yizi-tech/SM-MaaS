/* =====================================================================
   MASS Design System v1.0 —— 共享组件库
   提炼自参考稿 home_redesign.html（青蓝→亮紫渐变体系）
   规范文档：docs/DESIGN_SPEC.md
   ===================================================================== */

/* ============== 0. 设计 Tokens ============== */
:root{
  --brand-from:#1FB6FF; --brand-to:#7C5CFF;
  --brand-50:#eef5ff; --brand-100:#d9e8ff; --brand-200:#b9d4ff; --brand-300:#8cb6ff;
  --brand-400:#6b97ff; --brand-500:#5b6cff; --brand-600:#4a55f0; --brand-700:#3a40d6;
  --gray-1:#f7f8fa; --gray-2:#f2f3f5; --gray-3:#e5e6eb; --gray-4:#d0d3d9; --gray-5:#c9cdd4; --gray-6:#a9aeb8;
  --text-1:#1d2129; --text-2:#4e5969; --text-3:#86909c; --text-4:#c9cdd4;
  --bg-page:#f5f6f8; --bg-card:#ffffff; --bg-soft:#f2f3f5; --bg-hover:#eef0f4;
  --border-1:#e5e6eb; --border-2:#f2f3f5;
  --c-success:#00b42a; --c-warn:#ff7d00; --c-danger:#f53f3f; --c-info:#5b6cff;
  --gradient-brand:linear-gradient(135deg,#1FB6FF,#7C5CFF);
  --gradient-brand-soft:linear-gradient(180deg,#eef5ff,#ffffff 82%);
  --gradient-progress:linear-gradient(90deg,#1FB6FF,#7C5CFF);
  --focus-ring:0 0 0 3px rgba(91,108,255,.20);
  --shadow-xs:0 1px 2px rgba(0,0,0,.03);
  --shadow-sm:0 1px 4px rgba(0,0,0,.04);
  --shadow-md:0 4px 12px rgba(0,0,0,.06);
  --shadow-lg:0 8px 24px rgba(0,0,0,.08);
  --r-sm:6px; --r-md:8px; --r-lg:12px; --r-xl:16px;
  --side-w:208px; --header-h:56px;
  --font-sans:'Inter','Noto Sans SC',-apple-system,'Segoe UI',Roboto,'PingFang SC','Microsoft YaHei',sans-serif;
  --font-num:'JetBrains Mono','Inter',-apple-system,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{-webkit-text-size-adjust:100%;}
body{
  font-family:var(--font-sans); color:var(--text-1); background:var(--bg-page);
  font-size:14px; line-height:1.5; -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
input,select,textarea{font-family:inherit;}
:focus-visible{outline:none;box-shadow:var(--focus-ring);border-radius:var(--r-sm);}
.ic{flex:none;}

/* ============== 1. 布局骨架 ============== */
.app{display:flex;min-height:100vh;}
.side{width:var(--side-w);flex:none;background:var(--bg-card);border-right:1px solid var(--border-1);
  position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column;}
.main{flex:1;min-width:0;display:flex;flex-direction:column;}
.content{padding:24px 32px 40px;max-width:1440px;width:100%;margin:0 auto;}

/* ============== 2. 侧边栏 ============== */
.brand{display:flex;align-items:center;gap:10px;height:var(--header-h);padding:0 18px;
  border-bottom:1px solid var(--border-2);flex:none;}
.logo{width:30px;height:30px;border-radius:9px;background:var(--gradient-brand);
  display:grid;place-items:center;color:#fff;font-weight:700;font-size:13px;letter-spacing:.5px;
  box-shadow:0 2px 8px rgba(91,108,255,.35);flex:none;}
.brand__name{font-weight:700;font-size:15px;letter-spacing:.3px;line-height:1.25;}
.brand__name small{display:block;font-weight:400;font-size:10px;color:var(--text-3);letter-spacing:1px;}
.nav{padding:10px 10px 20px;flex:1;}
.nav__group{margin-top:6px;}
.nav__group-title{display:flex;align-items:center;gap:8px;padding:8px 12px 4px;
  font-size:12px;color:var(--text-3);font-weight:500;}
.nav__group-title .ic{width:14px;height:14px;opacity:.8;}
.nav__item{display:flex;align-items:center;gap:10px;height:38px;padding:0 12px;border-radius:var(--r-sm);
  color:var(--text-2);font-size:14px;position:relative;transition:background .15s,color .15s;cursor:pointer;}
.nav__item .ic{width:17px;height:17px;flex:none;color:var(--text-3);transition:color .15s;}
.nav__item:hover{background:var(--bg-hover);}
.nav__item.is-active{background:var(--bg-soft);color:var(--brand-700);font-weight:600;}
.nav__item.is-active .ic{color:var(--brand-500);}
.nav__item.is-active::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:3px;
  border-radius:0 3px 3px 0;background:var(--gradient-brand);}
.nav__item--sub{padding-left:36px;font-size:13px;height:34px;}
.badge-hot{margin-left:auto;font-size:10px;font-weight:600;color:#fff;background:var(--gradient-brand);
  padding:1px 6px;border-radius:999px;}
.side__balance{margin:auto 10px 10px;padding:12px;border-radius:var(--r-md);background:var(--brand-50);
  border:1px solid var(--brand-100);}
.side__balance .k{font-size:11px;color:var(--text-3);margin-bottom:2px;}
.side__balance .v{font-family:var(--font-num);font-size:18px;font-weight:600;color:var(--brand-700);}

/* ============== 3. 顶栏 ============== */
.header{height:var(--header-h);background:var(--bg-card);border-bottom:1px solid var(--border-2);
  position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:14px;padding:0 24px;}
.hamburger{display:none;width:36px;height:36px;border-radius:var(--r-sm);color:var(--text-2);
  align-items:center;justify-content:center;}
.hamburger:hover{background:var(--bg-hover);}
.breadcrumb{font-size:13px;color:var(--text-3);white-space:nowrap;}
.breadcrumb b{color:var(--text-1);font-weight:600;}
.search{flex:1;max-width:420px;margin:0 auto;position:relative;}
.search input{width:100%;height:34px;border:1px solid var(--border-1);border-radius:999px;
  background:var(--bg-page);padding:0 14px 0 36px;font-size:13px;color:var(--text-1);transition:border-color .15s,background .15s;}
.search input::placeholder{color:var(--text-4);}
.search input:focus{border-color:var(--brand-500);background:#fff;outline:none;}
.search .ic{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-4);}
.header__right{display:flex;align-items:center;gap:8px;margin-left:auto;}
.icon-btn{width:36px;height:36px;border-radius:var(--r-sm);color:var(--text-2);position:relative;
  display:grid;place-items:center;transition:background .15s;}
.icon-btn:hover{background:var(--bg-hover);}
.icon-btn .dot{position:absolute;top:8px;right:9px;width:7px;height:7px;border-radius:50%;
  background:var(--c-danger);border:1.5px solid #fff;}
.avatar{width:32px;height:32px;border-radius:50%;background:var(--gradient-brand);color:#fff;
  display:grid;place-items:center;font-size:13px;font-weight:600;margin-left:4px;flex:none;}

/* ============== 4. 按钮 ============== */
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 16px;
  border-radius:var(--r-sm);background:var(--gradient-brand);color:#fff;font-size:13px;font-weight:600;
  box-shadow:0 2px 10px rgba(91,108,255,.30);transition:transform .12s,box-shadow .15s;white-space:nowrap;}
.btn-primary:hover{box-shadow:0 4px 16px rgba(91,108,255,.44);}
.btn-primary:active{transform:translateY(1px) scale(.98);}
.btn-primary:disabled{opacity:.5;box-shadow:none;cursor:not-allowed;}
.btn-primary--lg{height:42px;padding:0 22px;font-size:14px;border-radius:var(--r-md);}
.btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 16px;
  border-radius:var(--r-sm);background:var(--bg-card);border:1px solid var(--gray-3);color:var(--text-2);
  font-size:13px;font-weight:500;transition:background .15s,border-color .15s,color .15s;white-space:nowrap;}
.btn-ghost:hover{background:var(--brand-50);border-color:var(--brand-200);color:var(--brand-700);}
.btn-ghost:active{background:var(--brand-100);}
.btn-ghost:disabled{opacity:.45;cursor:not-allowed;background:var(--bg-card);border-color:var(--gray-3);color:var(--text-3);}
.btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 16px;
  border-radius:var(--r-sm);background:#fff;border:1px solid #ffd0d0;color:var(--c-danger);
  font-size:13px;font-weight:500;transition:background .15s,border-color .15s;white-space:nowrap;}
.btn-danger:hover{background:#fff1f0;border-color:#ffb8b8;}
.btn-danger:active{background:#ffece8;}
.btn-danger:disabled{opacity:.45;cursor:not-allowed;}
.btn-danger--solid{background:var(--c-danger);border-color:var(--c-danger);color:#fff;}
.btn-danger--solid:hover{background:#d93636;border-color:#d93636;}
.btn-danger--solid:active{background:#c43131;}
.btn-link{color:var(--brand-500);font-size:13px;font-weight:500;transition:color .15s;display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}
.btn-link:hover{color:var(--brand-700);}
.btn-sm{height:28px;padding:0 12px;font-size:12px;border-radius:var(--r-sm);}
.btn-primary.btn-sm,.btn-ghost.btn-sm{padding:0 11px;}

/* ============== 5. 页头 ============== */
.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px;}
.page-head h1{font-size:22px;font-weight:700;letter-spacing:.2px;}
.page-head .sub{color:var(--text-3);font-size:13px;margin-top:4px;}
.health-pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:999px;
  background:#e8f9ed;color:var(--c-success);font-size:12px;font-weight:600;}
.health-pill .ic{width:14px;height:14px;}
.health-pill--warn{background:#fff3e8;color:var(--c-warn);}
.health-pill--info{background:var(--brand-50);color:var(--brand-600);}

/* ============== 6. 卡片 ============== */
.card{background:var(--bg-card);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);padding:20px;
  border:1px solid transparent;transition:box-shadow .18s,transform .18s;}
.card:hover{box-shadow:var(--shadow-md);}
.card--flat:hover{box-shadow:var(--shadow-sm);}
.card__title{display:flex;align-items:center;justify-content:space-between;gap:8px;
  font-size:15px;font-weight:600;margin-bottom:14px;}
.card__title .link{font-size:12px;font-weight:500;color:var(--brand-500);}
.card__title .link:hover{color:var(--brand-700);}

/* ============== 7. 快捷入口 ============== */
.quick-grid{display:grid;grid-template-columns:repeat(6,1fr);background:#fff;border-radius:var(--r-lg);
  box-shadow:var(--shadow-sm);overflow:hidden;border:1px solid var(--border-2);}
.quick-item{display:flex;flex-direction:column;align-items:center;gap:7px;padding:16px 8px;cursor:pointer;
  border-right:1px solid var(--border-2);transition:background .15s;}
.quick-item:last-child{border-right:0;}
.quick-item:hover{background:var(--bg-hover);}
.quick-item__ic{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;
  background:var(--brand-50);color:var(--brand-600);transition:background .15s,transform .15s;}
.quick-item:hover .quick-item__ic{background:var(--brand-100);transform:translateY(-2px);}
.quick-item__ic .ic{width:20px;height:20px;}
.quick-item__label{font-size:14px;font-weight:500;color:var(--text-1);}
.quick-item__hint{font-size:11px;color:var(--text-3);margin-top:-4px;}

/* ============== 8. 统计行 / 指标卡 ============== */
.stats-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:16px;}
.stats-row .card{display:flex;flex-direction:column;}
.stats-row .card > *{flex:none;}
.stats-row--4{grid-template-columns:repeat(4,1fr);}
.metric-card .m-label{font-size:13px;color:var(--text-3);display:flex;align-items:center;gap:6px;}
.metric-card .m-label .ic{width:15px;height:15px;color:var(--brand-500);}
.metric-card .m-value{font-family:var(--font-num);font-size:26px;font-weight:600;margin-top:8px;line-height:1.1;}
.metric-card .m-value small{font-size:12px;color:var(--text-3);font-weight:400;margin-left:4px;font-family:var(--font-sans);}
.metric-card .m-sub{font-size:12px;color:var(--text-3);margin-top:6px;}
.metric-card .m-sub .up{color:var(--c-success);font-weight:600;}
.metric-card .m-sub .down{color:var(--c-danger);font-weight:600;}

/* 余额 Hero */
.balance-top{display:flex;align-items:flex-end;gap:14px;margin-bottom:6px;}
.balance-top .big{font-family:var(--font-num);font-size:38px;font-weight:600;line-height:1;color:var(--text-1);}
.balance-top .cur{font-size:18px;color:var(--text-3);font-weight:500;margin-right:2px;}
.balance-top .unit{font-size:13px;color:var(--text-3);margin-bottom:4px;}
.balance-sub{font-size:12px;color:var(--text-3);margin-bottom:16px;}

/* 进度条 */
.plan{margin-top:12px;}
.plan__row{display:flex;align-items:center;justify-content:space-between;font-size:12px;margin-bottom:6px;}
.plan__name{color:var(--text-2);font-weight:500;}
.plan__rate{color:var(--brand-600);font-weight:600;font-family:var(--font-num);}
.plan__meta{color:var(--text-3);font-family:var(--font-num);}
.bar{height:6px;border-radius:999px;background:var(--gray-2);overflow:hidden;}
.bar__fill{height:100%;border-radius:999px;background:var(--gradient-progress);transition:width .4s ease;}
.bar__fill--success{background:linear-gradient(90deg,#4cd964,#00b42a);}
.bar__fill--warn{background:linear-gradient(90deg,#ffb84d,#ff7d00);}

/* 图表 */
.chart-wrap{position:relative;display:flex;flex-direction:column;flex:1;}
.spark{width:100%;height:88px;display:block;margin-top:6px;}
.spark-info{margin-top:4px;display:flex;align-items:baseline;gap:8px;}
.spark-info .v{font-family:var(--font-num);font-size:22px;font-weight:600;color:var(--text-1);}
.spark-info .p{font-size:11px;color:var(--text-3);}
.axis-x{display:flex;justify-content:space-between;font-size:11px;color:var(--text-3);margin-top:8px;font-family:var(--font-num);}
.chart-wrap .axis-x{margin-top:auto;padding-top:8px;}
.axis-x b{color:var(--text-1);font-weight:500;}
.metered-num{font-family:var(--font-num);font-size:22px;font-weight:600;color:var(--text-1);margin-top:2px;}
.metered-num small{font-size:12px;color:var(--text-3);font-weight:400;margin-left:4px;font-family:var(--font-sans);}
.mini-bars{display:flex;align-items:flex-end;gap:6px;height:64px;margin-top:10px;flex:1;}
.mini-bar{flex:1;border-radius:3px 3px 0 0;background:var(--gradient-progress);min-height:3px;opacity:.92;
  transition:opacity .15s,filter .15s;}
.mini-bar:hover{opacity:1;filter:brightness(1.08);}

/* ============== 9. 表格 ============== */
.table-wrap{overflow-x:auto;border-radius:var(--r-lg);background:var(--bg-card);box-shadow:var(--shadow-sm);}
.table{width:100%;border-collapse:collapse;font-size:13px;min-width:640px;}
.table thead th{background:var(--gray-1);color:var(--text-3);font-size:12px;font-weight:500;text-align:left;
  padding:11px 16px;border-bottom:1px solid var(--border-1);white-space:nowrap;}
.table tbody td{padding:13px 16px;border-bottom:1px solid var(--border-2);color:var(--text-2);vertical-align:middle;}
.table tbody tr{transition:background .12s;}
.table tbody tr:hover{background:var(--bg-hover);}
.table tbody tr:last-child td{border-bottom:0;}
.table .num{font-family:var(--font-num);color:var(--text-1);}
.table .mono{font-family:var(--font-num);font-size:12px;}
.table .t-actions{display:flex;gap:6px;align-items:center;}
.table__footer{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;font-size:12px;color:var(--text-3);}

/* ============== 10. 表单 ============== */
.field{margin-bottom:16px;}
.field label{display:block;font-size:13px;color:var(--text-2);font-weight:500;margin-bottom:6px;}
.field label .req{color:var(--c-danger);margin-left:2px;}
.input,.select,.textarea{width:100%;height:36px;border:1px solid var(--border-1);border-radius:var(--r-sm);
  background:#fff;padding:0 12px;font-size:13px;color:var(--text-1);transition:border-color .15s,box-shadow .15s;}
.textarea{height:auto;min-height:84px;padding:10px 12px;resize:vertical;line-height:1.6;}
.input:focus,.select:focus,.textarea:focus{outline:none;border-color:var(--brand-500);box-shadow:var(--focus-ring);}
.input::placeholder,.textarea::placeholder{color:var(--text-4);}
.input--mono{font-family:var(--font-num);}
.field .hint{font-size:12px;color:var(--text-3);margin-top:5px;}
.field .err{font-size:12px;color:var(--c-danger);margin-top:5px;display:none;}
.field.is-error .input,.field.is-error .textarea{border-color:var(--c-danger);}
.field.is-error .err{display:block;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;}
.form-grid .full{grid-column:1/-1;}
.amount-chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;}
.amount-chip{padding:9px 18px;border:1px solid var(--border-1);border-radius:var(--r-sm);background:#fff;
  font-family:var(--font-num);font-size:14px;font-weight:500;color:var(--text-2);transition:all .15s;}
.amount-chip:hover{border-color:var(--brand-300);color:var(--brand-600);}
.amount-chip.is-active{border-color:var(--brand-500);color:var(--brand-600);background:var(--brand-50);font-weight:600;}
.pay-methods{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.pay-method{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px;border:1px solid var(--border-1);
  border-radius:var(--r-md);background:#fff;cursor:pointer;transition:all .15s;font-size:13px;color:var(--text-2);}
.pay-method:hover{border-color:var(--brand-300);}
.pay-method.is-active{border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-700);font-weight:600;}
.pay-method .ic{width:22px;height:22px;}

/* ============== 11. 标签 / 状态 ============== */
.tag{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:500;padding:2px 10px;border-radius:999px;white-space:nowrap;}
.tag--success{background:#e8f9ed;color:var(--c-success);}
.tag--warn{background:#fff3e8;color:var(--c-warn);}
.tag--danger{background:#ffece8;color:var(--c-danger);}
.tag--info{background:var(--brand-50);color:var(--brand-600);}
.tag--gray{background:var(--gray-2);color:var(--text-3);}
.tag .ic{width:12px;height:12px;}
.tag-inline{display:inline-block;font-size:11px;padding:1px 7px;border-radius:4px;background:#fff;
  border:1px solid var(--brand-200);color:var(--brand-600);font-family:var(--font-num);margin:0 1px;}

/* ============== 12. 弹窗 ============== */
.modal-mask{position:fixed;inset:0;background:rgba(29,33,41,.4);z-index:50;display:none;align-items:flex-start;
  justify-content:center;padding:8vh 16px 16px;overflow-y:auto;}
.modal-mask.show{display:flex;}
.modal{background:#fff;border-radius:var(--r-xl);box-shadow:var(--shadow-lg);width:100%;max-width:520px;
  animation:modal-in .18s ease;}
@keyframes modal-in{from{opacity:0;transform:translateY(12px) scale(.98);}to{opacity:1;transform:none;}}
.modal__head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 0;}
.modal__title{font-size:16px;font-weight:700;}
.modal__close{width:30px;height:30px;border-radius:var(--r-sm);display:grid;place-items:center;color:var(--text-3);transition:background .15s;}
.modal__close:hover{background:var(--bg-hover);}
.modal__body{padding:16px 22px;}
.modal__foot{display:flex;justify-content:flex-end;gap:10px;padding:0 22px 20px;}

/* ============== 13. Toast ============== */
.toast-wrap{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:99;display:flex;flex-direction:column;gap:10px;align-items:center;pointer-events:none;}
.toast{display:flex;align-items:center;gap:9px;background:#fff;border-radius:var(--r-md);box-shadow:var(--shadow-lg);
  padding:11px 18px;font-size:13px;color:var(--text-1);animation:toast-in .22s ease;max-width:86vw;
  border:1px solid var(--border-2);}
.toast .ic{width:16px;height:16px;flex:none;}
.toast--success .ic{color:var(--c-success);}
.toast--error .ic{color:var(--c-danger);}
.toast--warn .ic{color:var(--c-warn);}
.toast--info .ic{color:var(--c-info);}
@keyframes toast-in{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
.toast.out{opacity:0;transform:translateY(6px);transition:all .25s;}

/* ============== 14. 空状态 / 加载 ============== */
.empty{padding:48px 20px;text-align:center;}
.empty__ic{width:56px;height:56px;border-radius:50%;background:var(--brand-50);color:var(--brand-400);
  display:grid;place-items:center;margin:0 auto 14px;}
.empty__ic .ic{width:26px;height:26px;}
.empty__title{font-size:14px;font-weight:600;color:var(--text-2);}
.empty__desc{font-size:12px;color:var(--text-3);margin-top:5px;}
.loading-row td{text-align:center;padding:36px;color:var(--text-3);font-size:13px;}
.spinner{width:16px;height:16px;border:2px solid var(--brand-100);border-top-color:var(--brand-500);
  border-radius:50%;display:inline-block;animation:spin .7s linear infinite;vertical-align:-3px;margin-right:8px;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ============== 15. 分页 ============== */
.pager{display:flex;gap:6px;align-items:center;}
.pager button{min-width:32px;height:32px;padding:0 8px;border-radius:var(--r-sm);border:1px solid var(--border-1);
  background:#fff;font-size:13px;color:var(--text-2);font-family:var(--font-num);transition:all .15s;display:grid;place-items:center;}
.pager button:hover:not(:disabled){border-color:var(--brand-300);color:var(--brand-600);}
.pager button.is-active{background:var(--gradient-brand);border-color:transparent;color:#fff;font-weight:600;}
.pager button:disabled{opacity:.4;cursor:not-allowed;}

/* ============== 16. Tabs ============== */
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--border-1);margin-bottom:18px;}
.tab{padding:10px 16px;font-size:14px;color:var(--text-3);font-weight:500;position:relative;transition:color .15s;}
.tab:hover{color:var(--text-1);}
.tab.is-active{color:var(--brand-600);font-weight:600;}
.tab.is-active::after{content:"";position:absolute;left:16px;right:16px;bottom:-1px;height:2px;border-radius:2px;
  background:var(--gradient-brand);}

/* ============== 17. 帮助/学习区 ============== */
.learn-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.learn-item{padding:18px;border-radius:var(--r-md);background:var(--gray-1);display:flex;flex-direction:column;gap:10px;
  cursor:pointer;transition:background .15s,transform .15s;height:100%;}
.learn-item:hover{background:var(--brand-50);transform:translateY(-2px);}
.learn-item__head{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.learn-item__title{font-size:14px;font-weight:600;color:var(--text-1);}
.learn-item__ic{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:#fff;flex:none;}
.learn-item__ic .ic{width:15px;height:15px;}
.learn-item__desc{font-size:12px;color:var(--text-3);line-height:1.65;}
.tone-1{background:var(--gradient-brand);}
.tone-2{background:linear-gradient(135deg,#00b4ff,#00d4ff);}
.tone-3{background:linear-gradient(135deg,#ff7d00,#ffb84d);}
.tone-4{background:linear-gradient(135deg,#00b42a,#4cd964);}

/* ============== 18. 定价卡 ============== */
.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.plan-card{background:var(--bg-card);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);padding:26px 24px;
  border:1px solid var(--border-2);position:relative;transition:box-shadow .18s,transform .18s;display:flex;flex-direction:column;}
.plan-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
.plan-card.is-hot{border-color:var(--brand-400);}
.plan-card.is-current{border-color:var(--brand-500);box-shadow:0 4px 18px rgba(91,108,255,.18);}
.plan-card__flag{position:absolute;top:-11px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:600;
  color:#fff;background:var(--gradient-brand);padding:3px 12px;border-radius:999px;white-space:nowrap;}
.plan-card__name{font-size:16px;font-weight:700;}
.plan-card__desc{font-size:12px;color:var(--text-3);margin-top:3px;min-height:32px;}
.plan-card__price{font-family:var(--font-num);font-size:34px;font-weight:700;margin:14px 0 2px;line-height:1;}
.plan-card__price small{font-size:13px;color:var(--text-3);font-weight:400;font-family:var(--font-sans);}
.plan-card__features{list-style:none;margin:16px 0 20px;flex:1;}
.plan-card__features li{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--text-2);padding:5px 0;}
.plan-card__features .ic{width:15px;height:15px;color:var(--c-success);flex:none;}
.plan-card__features li.na{color:var(--text-4);}
.plan-card__features li.na .ic{color:var(--text-4);}

/* ============== 19. 认证页卡片（布局见 §24 分栏式登录） ============== */
.auth-card{width:100%;max-width:400px;background:#fff;border-radius:var(--r-xl);box-shadow:var(--shadow-lg);
  padding:36px 34px;position:relative;z-index:1;}
.auth-card .logo{width:44px;height:44px;border-radius:13px;font-size:17px;margin:0 auto 14px;}
.auth-card h1{font-size:20px;font-weight:700;text-align:center;}
.auth-card .auth-sub{font-size:13px;color:var(--text-3);text-align:center;margin:6px 0 24px;}
.auth-card .btn-primary{width:100%;height:42px;font-size:14px;margin-top:4px;}
.auth-switch{text-align:center;font-size:13px;color:var(--text-3);margin-top:18px;}
.auth-switch a{color:var(--brand-500);font-weight:600;cursor:pointer;}
.auth-switch a:hover{color:var(--brand-700);}

/* ============== 20. 描述列表 / 详情 ============== */
.desc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px 24px;}
.desc-item{display:flex;gap:10px;font-size:13px;padding:6px 0;}
.desc-item .k{color:var(--text-3);flex:none;width:92px;}
.desc-item .v{color:var(--text-1);word-break:break-all;}
.desc-item .v.mono{font-family:var(--font-num);font-size:12px;}
.divider{height:1px;background:var(--border-2);margin:16px 0;}

/* ============== 21. 移动端抽屉 ============== */
.scrim{display:none;position:fixed;inset:0;background:rgba(29,33,41,.4);z-index:35;}

/* ============== 22. 响应式 ============== */
@media (max-width:1200px){
  .stats-row--4{grid-template-columns:1fr 1fr;}
  .plan-grid{grid-template-columns:1fr 1fr;}
}
@media (max-width:1024px){
  .hamburger{display:flex;}
  .side{position:fixed;left:0;top:0;z-index:40;transform:translateX(-100%);transition:transform .22s;}
  .side.open{transform:translateX(0);box-shadow:var(--shadow-lg);}
  .scrim.show{display:block;}
  .search{display:none;}
  .quick-grid{grid-template-columns:repeat(3,1fr);}
  .quick-item:nth-child(3n){border-right:0;}
  .quick-item:nth-child(n+4){border-top:1px solid var(--border-2);}
  .stats-row{grid-template-columns:1fr 1fr;}
  .learn-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:640px){
  .content{padding:16px 16px 28px;}
  .header{padding:0 12px;gap:8px;}
  .breadcrumb{display:none;}
  .quick-grid{grid-template-columns:repeat(2,1fr);}
  .quick-item:nth-child(3n){border-right:1px solid var(--border-2);}
  .quick-item:nth-child(2n){border-right:0;}
  .quick-item{border-top:1px solid var(--border-2);}
  .quick-item:nth-child(-n+2){border-top:0;}
  .stats-row,.stats-row--4{grid-template-columns:1fr;}
  .learn-grid,.plan-grid,.form-grid,.desc-grid,.pay-methods{grid-template-columns:1fr;}
  .page-head h1{font-size:19px;}
  .page-head{gap:12px;}
  .balance-top .big{font-size:32px;}
  .auth-card{padding:28px 22px;}
  .modal__body{max-height:62vh;overflow-y:auto;}
  /* ---- 按钮移动端规则：图标全部收起、文字强制保留 ---- */
  .btn-primary [data-ic],.btn-ghost [data-ic],.btn-danger [data-ic],
  .btn-primary > svg,.btn-ghost > svg,.btn-danger > svg,
  .btn-link [data-ic],.btn-link > svg{display:none;}
  .btn-primary span,.btn-ghost span,.btn-danger span{display:inline;}
  .btn-primary,.btn-ghost,.btn-danger{height:36px;font-size:13px;}
  .btn-sm{height:30px;}
  /* 弹窗脚：按钮纵向全宽，避免被挤压丢字 */
  .modal__foot{display:flex;flex-direction:column;gap:8px;}
  .modal__foot .btn-primary,.modal__foot .btn-ghost,.modal__foot .btn-danger{width:100%;height:38px;}
  /* 表格操作列允许换行 */
  .table .t-actions{flex-wrap:wrap;}
  /* 分页器换行、大触控点 */
  .pager{flex-wrap:wrap;}
  .pager button{min-width:36px;height:36px;}
}
/* 触屏设备统一放大按钮触控区 */
@media (pointer:coarse){
  .btn-primary,.btn-ghost,.btn-danger{height:38px;font-size:13.5px;}
  .btn-sm{height:32px;}
  .icon-btn,.hamburger{width:40px;height:40px;}
  .page-head .btn-primary,.page-head .btn-ghost{padding:0 18px;}
}

/* ============== 23. 视图切换 ============== */
.view{display:none;}
.view.is-active{display:block;animation:view-in .2s ease;}
@keyframes view-in{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
.section-gap{margin-top:24px;}

/* ============== 24. 认证页升级：分栏式登录 ============== */
.auth-split{display:grid;grid-template-columns:1.12fr 1fr;min-height:100vh;background:var(--bg-page);}

/* 左：品牌叙事区（深靛底 + 品牌光斑） */
.auth-brand{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;
  padding:56px 64px;background:linear-gradient(140deg,#0f1440 0%,#1a1f5e 48%,#2b2a7a 100%);color:#fff;}
.auth-brand::before{content:"";position:absolute;top:-180px;right:-120px;width:460px;height:460px;border-radius:50%;
  background:radial-gradient(circle,rgba(31,182,255,.42),transparent 66%);}
.auth-brand::after{content:"";position:absolute;bottom:-210px;left:-140px;width:520px;height:520px;border-radius:50%;
  background:radial-gradient(circle,rgba(124,92,255,.40),transparent 66%);}
.auth-dots{position:absolute;top:44px;right:52px;width:140px;height:140px;opacity:.32;z-index:1;
  background-image:radial-gradient(rgba(255,255,255,.55) 1.2px,transparent 1.2px);background-size:14px 14px;}
.auth-brand__in{position:relative;z-index:2;max-width:480px;}
.auth-brand .brand{border:0;padding:0;height:auto;margin-bottom:40px;}
.auth-brand .brand .logo{width:36px;height:36px;border-radius:11px;font-size:14px;}
.auth-brand .brand__name{color:#fff;font-size:17px;}
.auth-brand .brand__name small{color:rgba(255,255,255,.55);}
.auth-brand h2{font-size:29px;font-weight:700;line-height:1.4;letter-spacing:.3px;}
.auth-brand h2 em{font-style:normal;background:linear-gradient(90deg,#7fd4ff,#b9a5ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;}
.auth-brand .brand-sub{margin-top:12px;font-size:14px;color:rgba(255,255,255,.66);line-height:1.75;}
.auth-feats{margin-top:34px;display:flex;flex-direction:column;gap:12px;}
.auth-feat{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;border-radius:var(--r-md);
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.13);transition:background .15s,transform .15s;}
.auth-feat:hover{background:rgba(255,255,255,.10);transform:translateX(3px);}
.auth-feat__ic{width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.12);
  display:grid;place-items:center;color:#9fd0ff;flex:none;}
.auth-feat__tt{font-size:14px;font-weight:600;}
.auth-feat__ds{font-size:12px;color:rgba(255,255,255,.60);margin-top:3px;line-height:1.65;}
.auth-stats{display:flex;gap:36px;margin-top:38px;padding-top:24px;border-top:1px solid rgba(255,255,255,.12);}
.auth-stats .st .v{font-family:var(--font-num);font-size:22px;font-weight:600;
  background:linear-gradient(90deg,#7fd4ff,#b9a5ff);-webkit-background-clip:text;background-clip:text;color:transparent;}
.auth-stats .st .k{font-size:12px;color:rgba(255,255,255,.55);margin-top:3px;}

/* 右：表单区 */
.auth-panel{display:flex;align-items:center;justify-content:center;padding:36px 24px;position:relative;overflow:hidden;}
.auth-panel::before{content:"";position:absolute;top:-140px;right:-140px;width:380px;height:380px;border-radius:50%;
  background:radial-gradient(circle,rgba(31,182,255,.10),transparent 68%);}
.auth-panel .auth-card{max-width:420px;box-shadow:var(--shadow-md);}

/* 表单增强 */
.input-wrap{position:relative;}
.input-wrap .input{padding-right:40px;}
.input-eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:6px;
  display:grid;place-items:center;color:var(--text-4);transition:color .15s,background .15s;}
.input-eye:hover{color:var(--text-2);background:var(--bg-hover);}
.auth-row{display:flex;align-items:center;justify-content:space-between;margin:-2px 0 16px;font-size:13px;}
.auth-row label{display:flex;align-items:center;gap:6px;color:var(--text-2);cursor:pointer;user-select:none;}
.auth-row input[type=checkbox]{accent-color:var(--brand-500);width:15px;height:15px;}
.auth-row a{color:var(--brand-500);font-weight:500;cursor:pointer;}
.auth-row a:hover{color:var(--brand-700);}
.btn-primary .spinner{border-color:rgba(255,255,255,.45);border-top-color:#fff;margin-right:2px;}
.auth-card .auth-terms{font-size:11px;color:var(--text-4);text-align:center;margin-top:14px;line-height:1.7;}
.auth-card .auth-terms a{color:var(--brand-500);cursor:pointer;}

@media (max-width:1024px){
  .auth-split{grid-template-columns:1fr;}
  .auth-brand{display:none;}
}
@media (max-width:640px){
  .auth-panel{padding:20px 16px;}
}

/* 注册页专属：密码强度 / 匹配反馈 / 权益条 / 协议勾选 */
.pwd-meter{display:flex;gap:5px;margin-top:8px;}
.pwd-meter i{flex:1;height:4px;border-radius:999px;background:var(--gray-3);transition:background .2s;}
.pwd-meter[data-lv="1"] i:nth-child(-n+1){background:var(--c-danger);}
.pwd-meter[data-lv="2"] i:nth-child(-n+2){background:var(--c-warn);}
.pwd-meter[data-lv="3"] i:nth-child(-n+3){background:#7bd88a;}
.pwd-meter[data-lv="4"] i{background:var(--c-success);}
.pwd-hint{font-size:11px;color:var(--text-4);margin-top:5px;display:flex;justify-content:space-between;}
.pwd-hint .lv{font-weight:500;}
.pwd-hint .lv[data-lv="1"]{color:var(--c-danger);}
.pwd-hint .lv[data-lv="2"]{color:var(--c-warn);}
.pwd-hint .lv[data-lv="3"],.pwd-hint .lv[data-lv="4"]{color:var(--c-success);}
.match-tip{display:none;align-items:center;gap:5px;font-size:12px;margin-top:6px;font-weight:500;}
.match-tip .ic{width:13px;height:13px;}
.match-tip.ok{display:flex;color:var(--c-success);}
.match-tip.bad{display:flex;color:var(--c-danger);}
.reg-perks{display:flex;align-items:center;gap:10px;background:var(--brand-50);border:1px dashed var(--brand-300);
  border-radius:var(--r-md);padding:10px 14px;margin-bottom:18px;font-size:12px;color:var(--brand-700);line-height:1.6;}
.reg-perks .ic{width:16px;height:16px;color:var(--brand-500);flex:none;}
.agree-row{display:flex;align-items:flex-start;gap:8px;margin:-2px 0 16px;font-size:12px;color:var(--text-3);line-height:1.7;}
.agree-row input[type=checkbox]{accent-color:var(--brand-500);width:15px;height:15px;margin-top:2px;flex:none;}
.agree-row a{color:var(--brand-500);font-weight:500;cursor:pointer;}
.agree-row a:hover{color:var(--brand-700);}
.agree-row.is-error{color:var(--c-danger);}

/* 注册成功：欢迎态（保留分栏上下文，在右侧完成确认） */
.auth-success{display:none;text-align:center;animation:view-in .28s ease;}
.auth-success.is-show{display:block;}
.auth-success__mark{width:66px;height:66px;margin:0 auto 18px;border-radius:22px;color:#fff;background:var(--gradient-brand);
  display:grid;place-items:center;box-shadow:0 8px 24px rgba(91,108,255,.28);}
.auth-success__mark .ic{width:31px;height:31px;}
.auth-success h1{font-size:22px;}
.auth-success p{font-size:13px;color:var(--text-3);line-height:1.75;margin:8px auto 22px;max-width:290px;}
.success-steps{display:flex;text-align:left;gap:10px;padding:14px;margin:0 0 20px;border-radius:var(--r-md);
  background:var(--brand-50);border:1px solid var(--brand-100);}
.success-steps__num{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;flex:none;
  background:var(--gradient-brand);color:#fff;font-family:var(--font-num);font-size:12px;font-weight:600;}
.success-steps__text{font-size:12px;color:var(--text-2);line-height:1.65;}
.success-steps__text b{display:block;color:var(--brand-700);font-size:13px;}
.auth-card.is-success .auth-card__form{display:none;}
.auth-card.is-success .auth-success{display:block;}

/* ---------- Section head ---------- */
.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;}
.section-title{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;margin:0;}
.section-title .ic{color:var(--brand-600);}
.section-sub{font-size:12px;color:var(--text-3);margin-top:3px;}

/* ---------- Token package card ---------- */
.tp-card{display:flex;flex-direction:column;background:var(--bg-card);border-radius:var(--r-lg);
  box-shadow:var(--shadow-sm);padding:24px 22px;position:relative;border:1px solid var(--border-1);
  transition:box-shadow .18s,transform .18s;}
.tp-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
.tp-card.is-hot{border-color:var(--brand-400);background:linear-gradient(180deg,var(--brand-50),#fff 55%);}
.tp-card__flag{position:absolute;top:-11px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:600;
  padding:3px 12px;border-radius:999px;background:var(--gradient-brand);color:#fff;letter-spacing:.3px;}
.tp-card__name{font-size:16px;font-weight:700;display:flex;align-items:center;gap:6px;}
.tp-card__desc{font-size:12px;color:var(--text-3);margin-top:4px;min-height:32px;line-height:1.6;}
.tp-card__tokens{display:flex;align-items:baseline;gap:6px;margin:14px 0 2px;}
.tp-card__tokens b{font-family:var(--font-num);font-size:22px;font-weight:700;color:var(--brand-700);line-height:1;}
.tp-card__tokens span{font-size:12px;color:var(--text-3);}
.tp-card__bonus{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:#e8590c;
  background:#fff4e6;border:1px solid #ffd8a8;padding:2px 8px;border-radius:999px;margin-top:6px;}
.tp-card__price{display:flex;align-items:baseline;margin:14px 0 16px;}
.tp-card__price b{font-family:var(--font-num);font-size:26px;font-weight:700;line-height:1;}
.tp-card__price small{font-size:12px;color:var(--text-3);}
.tp-card__btn{width:100%;}

/* ---------- Upload box ---------- */
.upload-box{position:relative;border:1.5px dashed var(--border-2);border-radius:var(--r-md);
  background:#fafbfe;cursor:pointer;overflow:hidden;transition:border-color .18s,background .18s;
  display:flex;align-items:center;justify-content:center;min-height:120px;}
.upload-box:hover{border-color:var(--brand-400);background:var(--brand-50);}
.upload-box.is-uploaded{border-style:solid;border-color:var(--green-3, #59b06c);}
.upload-box__ph{display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--text-3);
  font-size:12px;padding:20px;text-align:center;}
.upload-box__ph .ic{color:var(--brand-500);}
.upload-box__preview{display:none;width:100%;height:130px;object-fit:cover;border-radius:var(--r-sm);}
.upload-box__status{position:absolute;left:10px;right:10px;bottom:10px;font-size:11px;text-align:center;
  padding:5px 8px;border-radius:6px;background:rgba(255,255,255,.92);backdrop-filter:blur(2px);}
.upload-box__status.is-ok{color:var(--green-6,#2f9e44);}
.upload-box__status.is-loading{color:var(--text-2);}
.upload-box__status.is-error{color:#e03131;}

/* ---------- Model card (模型广场) ---------- */
.md-card{display:flex;flex-direction:column;background:var(--bg-card);border-radius:var(--r-lg);
  box-shadow:var(--shadow-sm);padding:22px;border:1px solid var(--border-1);transition:box-shadow .18s,transform .18s;gap:8px;}
.md-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
.md-card__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
.md-card__badge{font-size:11px;font-weight:600;letter-spacing:.4px;color:#0b6e4f;
  background:#e6f4ef;border:1px solid #c3e8db;padding:3px 10px;border-radius:999px;}
.md-card__badge.is-anth{color:#b65314;background:#fdf0e3;border-color:#f4d3b4;}
.md-card__status{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--text-2);}
.md-card__status i{width:7px;height:7px;border-radius:50%;background:#37b24d;box-shadow:0 0 0 3px rgba(55,178,77,.18);}
.md-card__name{font-size:17px;font-weight:700;}
.md-card__id{font-family:var(--font-mono);font-size:12px;color:var(--text-3);}
.md-card__desc{font-size:12.5px;color:var(--text-2);line-height:1.65;margin:2px 0 4px;min-height:44px;}
.md-card__feats{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px;min-height:24px;}
.md-card__meta{display:flex;gap:10px;border-top:1px dashed var(--border-1);padding-top:14px;margin-top:auto;}
.md-card__meta-item{display:flex;flex-direction:column;gap:2px;flex:1;}
.md-card__meta-item span{font-size:10.5px;color:var(--text-3);}
.md-card__meta-item b{font-family:var(--font-num);font-size:14px;font-weight:700;}
.md-card__meta-item small{font-size:10px;color:var(--text-3);}

/* ---------- 用量明细 ---------- */
.usage-detail{display:flex;flex-direction:column;gap:10px;}
.fmt-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:10px;border-bottom:1px solid var(--border-1);}
.fmt-date{font-family:var(--font-num);font-size:13px;color:var(--text-2);font-weight:600;}
.fmt-stat{display:grid;grid-template-columns:1fr;gap:6px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:10px;padding:10px 12px;}
.fmt-stat>div{display:flex;align-items:baseline;gap:10px;font-size:12.5px;min-width:0;}
.fmt-stat .k{flex:none;width:56px;color:var(--text-3);font-size:11.5px;}
.fmt-stat .v{color:var(--text-1);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fmt-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.fmt-metrics .m{display:flex;flex-direction:column;gap:3px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:10px;padding:10px 12px;}
.fmt-metrics .k{font-size:11px;color:var(--text-3);}
.fmt-metrics .v{font-family:var(--font-num);font-size:14.5px;font-weight:700;color:var(--text-1);}
.fmt-cache{display:flex;align-items:center;gap:6px;font-size:12px;color:#9a6b13;background:#fff7e8;border:1px solid #f3e3bd;border-radius:8px;padding:7px 10px;}
.fmt-card{background:var(--bg-2);border:1px solid var(--border-1);border-radius:10px;padding:4px 12px;}
.fmt-title{font-size:12px;font-weight:700;color:var(--text-2);padding:9px 2px 6px;border-bottom:1px dashed var(--border-1);margin-bottom:2px;}
.fmt-line{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12.5px;color:var(--text-2);padding:5.5px 2px;}
.fmt-line .mono{font-family:var(--font-num);font-size:12.5px;font-weight:500;color:var(--text-1);}
.fmt-line--sub{color:var(--text-3);}
.fmt-total{border-top:1px dashed var(--border-1);margin-top:2px;padding:9px 2px 10px;color:var(--text-1);font-weight:700;}
.fmt-total .mono{font-size:14px;font-weight:700;color:var(--brand-600,var(--brand-500));}

/* ---------- 对话测试 ---------- */
.chat-shell{height:calc(100vh - 218px);min-height:460px;display:flex;flex-direction:column;padding:0;overflow:hidden;border-radius:var(--r-xl);}
.chat-head{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border-1);
  background:linear-gradient(180deg,var(--gradient-brand-soft));flex:none;flex-wrap:wrap;}
.chat-head__select{width:210px;height:34px;flex:none;}
.chat-head__status{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text-3);white-space:nowrap;}
.chat-head__dot{width:7px;height:7px;border-radius:50%;background:var(--c-success);box-shadow:0 0 0 3px rgba(0,180,42,.14);flex:none;}
.chat-head.is-busy .chat-head__dot{background:var(--c-warn);box-shadow:0 0 0 3px rgba(255,125,0,.16);animation:chatPulse 1.1s ease-in-out infinite;}
.chat-head__fill{flex:1;}
@keyframes chatPulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.chat-log{flex:1;overflow-y:auto;padding:22px 22px 10px;display:flex;flex-direction:column;gap:16px;background:var(--bg-soft,var(--bg-page));scroll-behavior:smooth;}
.chat-empty{margin:auto;text-align:center;color:var(--text-3);padding:30px 0;max-width:560px;}
.chat-empty__orb{width:56px;height:56px;margin:0 auto 16px;border-radius:18px;background:var(--gradient-brand);color:#fff;
  display:grid;place-items:center;box-shadow:0 8px 24px rgba(91,108,255,.35);}
.chat-empty__orb .ic{width:26px;height:26px;}
.chat-empty__title{font-size:17px;font-weight:700;color:var(--text-1);margin-bottom:8px;}
.chat-empty__sub{font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:22px;}
.chat-empty__sub b{color:var(--brand-600);font-weight:600;}
.chat-suggests{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}
.chat-chip{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 16px;border-radius:999px;background:var(--bg-card);
  border:1px solid var(--border-1);box-shadow:var(--shadow-xs);color:var(--text-2);font-size:13px;cursor:pointer;
  transition:all .15s;user-select:none;}
.chat-chip:hover{border-color:var(--brand-300);color:var(--brand-700);box-shadow:0 4px 12px rgba(91,108,255,.16);transform:translateY(-1px);}
.chat-chip .ic{width:14px;height:14px;color:var(--brand-500);}
.chat-hint{font-size:12px;color:var(--text-3);line-height:1.5;}
.chat-msg{display:flex;gap:10px;max-width:86%;}
.chat-msg--assistant{align-self:flex-start;align-items:flex-start;}
.chat-msg--user{align-self:flex-end;align-items:flex-start;flex-direction:row-reverse;}
.chat-msg__avatar{width:32px;height:32px;border-radius:10px;flex:none;display:grid;place-items:center;color:#fff;}
.chat-msg--assistant .chat-msg__avatar{background:var(--gradient-brand);box-shadow:0 2px 8px rgba(91,108,255,.32);}
.chat-msg--user .chat-msg__avatar{background:linear-gradient(135deg,#5b6cff,#7c5cff);box-shadow:0 2px 8px rgba(124,92,255,.30);}
.chat-msg__avatar .ic{width:17px;height:17px;}
.chat-msg__col{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1;}
.chat-msg--user .chat-msg__col{align-items:flex-end;}
.chat-msg__content{white-space:pre-wrap;word-break:break-word;line-height:1.75;font-size:14px;padding:11px 15px;border-radius:14px;
  background:var(--bg-card);border:1px solid var(--border-1);box-shadow:0 1px 3px rgba(16,24,40,.05);}
.chat-msg--user .chat-msg__content{background:var(--gradient-brand);border-color:transparent;color:#fff;box-shadow:0 4px 14px rgba(91,108,255,.28);}
.chat-msg--assistant .chat-msg__content{border-top-left-radius:4px;}
.chat-msg--user .chat-msg__content{border-top-right-radius:4px;}
.chat-msg__think{border:1px solid var(--border-1);border-radius:12px;overflow:hidden;background:var(--bg-card);box-shadow:var(--shadow-xs);}
.chat-msg__think-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 12px;font-size:12px;
  color:var(--text-3);cursor:pointer;user-select:none;}
.chat-msg__think-head:hover{background:var(--bg-hover,#eef0f4);}
.chat-msg__think-arrow{transition:transform .2s;font-size:10px;}
.chat-msg__think.is-open .chat-msg__think-arrow{transform:rotate(180deg);}
.chat-msg__think-body{display:none;padding:0 12px 10px;font-size:13px;color:var(--text-3);white-space:pre-wrap;word-break:break-word;
  line-height:1.65;max-height:280px;overflow-y:auto;border-top:1px dashed var(--border-1);}
.chat-msg__think.is-open .chat-msg__think-body{display:block;}
.chat-msg__meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--text-3);padding:0 4px;}
.chat-msg--user .chat-msg__meta{justify-content:flex-end;}
.chat-msg__copy{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 8px;border-radius:6px;font-size:11.5px;
  color:var(--text-3);opacity:0;transition:opacity .15s,background .15s,color .15s;}
.chat-msg:hover .chat-msg__copy{opacity:1;}
.chat-msg__copy:hover{background:var(--bg-hover,#eef0f4);color:var(--brand-600);}
.chat-msg__copy .ic{width:12px;height:12px;}
.chat-msg--streaming .chat-msg__content::after{content:"";display:inline-block;width:8px;height:15px;margin-left:3px;vertical-align:-2px;
  border-radius:2px;background:var(--brand-500);animation:chatBlink 1s steps(2,start) infinite;}
.chat-msg--user.chat-msg--streaming .chat-msg__content::after{background:#fff;}
@keyframes chatBlink{0%,100%{opacity:1;}50%{opacity:0;}}
.chat-composer{padding:12px 16px 14px;border-top:1px solid var(--border-1);background:var(--bg-card);display:flex;flex-direction:column;gap:8px;flex:none;}
.chat-composer .chat-input{width:100%;min-height:44px;max-height:160px;resize:none;border:1px solid var(--border-1);border-radius:12px;
  background:var(--bg-soft,var(--bg-page));padding:11px 14px;font-size:14px;line-height:1.6;color:var(--text-1);transition:border-color .15s,box-shadow .15s,background .15s;}
.chat-composer .chat-input::placeholder{color:var(--text-4);}
.chat-composer .chat-input:focus{outline:none;border-color:var(--brand-400);background:#fff;box-shadow:var(--focus-ring);}
.chat-composer__bar{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;}
.chat-composer__actions{display:flex;align-items:center;gap:8px;flex:none;}
.chat-btn-stop{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 16px;border-radius:var(--r-sm);
  background:#fff;border:1px solid #ffd0d0;color:var(--c-danger);font-size:13px;font-weight:600;transition:background .15s,transform .12s;}
.chat-btn-stop:hover{background:#fff1f0;}
.chat-btn-stop:active{transform:translateY(1px) scale(.98);}
@media (max-width:640px){
  .chat-shell{height:calc(100vh - 200px);min-height:420px;}
  .chat-msg{max-width:92%;}
  .chat-head__select{width:100%;}
  .chat-suggests{gap:8px;}
}

/* ---------- 法律文书 ---------- */
.legal-doc{max-height:62vh;overflow-y:auto;white-space:pre-wrap;word-break:break-word;line-height:1.9;font-size:13.5px;color:var(--text-2);padding-right:6px;}

/* ---------- 修改密码验证码 ---------- */
.vm-row{display:flex;gap:10px;flex-wrap:wrap;}
.vm-item{display:flex;align-items:center;gap:6px;border:1px solid var(--border-1);border-radius:8px;padding:8px 12px;font-size:13px;color:var(--text-2);cursor:pointer;}
.vm-item b{font-weight:500;color:var(--text-3);}
.vm-item:has(input:checked){border-color:var(--brand-500,#4f6ef7);background:rgba(79,110,247,.06);color:var(--text-1);}
.vm-item:has(input:disabled){opacity:.55;cursor:not-allowed;background:var(--bg-soft,var(--bg-page));}
.code-row{display:flex;gap:10px;align-items:center;}
.code-row .input{flex:1;font-family:var(--font-num);letter-spacing:4px;}
.code-row .btn-ghost{flex:none;min-width:130px;}
