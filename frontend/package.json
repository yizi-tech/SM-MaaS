{
  "name": "mass-frontend",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/shared",
    "packages/user-app",
    "packages/admin-app"
  ],
  "scripts": {
    "dev:user": "npm run dev -w @mass/user-app",
    "dev:admin": "npm run dev -w @mass/admin-app",
    "build:user": "npm run build -w @mass/user-app",
    "build:admin": "npm run build -w @mass/admin-app",
    "build": "npm run build:user && npm run build:admin",
    "preview:user": "npm run preview -w @mass/user-app",
    "preview:admin": "npm run preview -w @mass/admin-app"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.6"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  }
}
